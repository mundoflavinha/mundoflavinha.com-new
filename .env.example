# Sem prefixo VITE_ de propósito: essas variáveis só são lidas pela function
# serverless (api/videos.ts), nunca pelo navegador. Com VITE_, o Vite embute o
# valor no bundle público no build — foi exatamente isso que expôs a chave
# antes (issue #4). Ver README para detalhes.
YOUTUBE_API_KEY=cole_aqui_sua_api_key_do_youtube_data_api
YOUTUBE_CHANNEL_ID=UCIjEV6h3lW0VmK7jguWJfrw
YOUTUBE_HANDLE=mundoflavinha
YOUTUBE_MAX_RESULTS=

# String de conexão do Neon (use o "Pooler host", não o host direto)
# Formato: postgresql://usuario:senha@host-pooler.../neondb?sslmode=require
DATABASE_URL=

# ID de medição do Google Analytics 4 (formato G-XXXXXXXXXX).
#
# PUBLIC_ de propósito: este valor É público — aparece no HTML de qualquer site
# que use GA, e precisa chegar ao navegador para a tag funcionar. Não confundir
# com as chaves acima, que nunca podem sair do servidor.
#
# Deixe VAZIO em preview e desenvolvimento: sem a variável, nenhuma tag do
# Google é emitida no HTML. Medir o próprio desenvolvimento sujaria o dado que
# a medição existe para produzir. Configure só no ambiente Production da Vercel.
PUBLIC_GA_ID=
