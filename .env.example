# Sem prefixo PUBLIC_ de propósito: essas variáveis só são lidas pela function
# (functions/api/videos.ts), nunca pelo navegador. Neste projeto (Astro) é o
# prefixo PUBLIC_ que o bundler embute no HTML público — herdeiro direto do
# VITE_ da era anterior (Vite puro), mesmo mecanismo, nome novo. Foi um
# vazamento desse tipo que expôs a chave antes (issue #4). Ver README.
YOUTUBE_API_KEY=cole_aqui_sua_api_key_do_youtube_data_api
YOUTUBE_CHANNEL_ID=UCIjEV6h3lW0VmK7jguWJfrw
YOUTUBE_HANDLE=mundoflavinha
YOUTUBE_MAX_RESULTS=

# String de conexão do Neon (use o "Pooler host", não o host direto)
# Formato: postgresql://usuario:senha@host-pooler.../neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# TAGGING — modo ÚNICO e mutuamente exclusivo. Ver docs/adr/0001.
#
#   direct   → o site carrega GA4 e/ou Meta Pixel diretamente   (PRODUÇÃO HOJE)
#   gtm      → o site carrega SÓ o container do GTM; GA4/Meta vêm de dentro dele
#   disabled → nenhuma tag externa (preview, dev, emergência)
#
# Configuração inválida DERRUBA o build e o dev server (astro.config.mjs).
# Ex.: PUBLIC_TAGGING_MODE=gtm com PUBLIC_GA_ENABLED=true é erro — duplicaria
# cada pageview e cada conversão.
#
# Em builds da Cloudflare Pages o modo é OBRIGATÓRIO (Production: direct;
# Preview: disabled). Localmente, vazio = disabled.
#
# PUBLIC_* é embutido no bundle EM TEMPO DE BUILD. Mudar exige novo deploy.
#
# Removidas (definir qualquer uma quebra o build com instrução de migração):
#   PUBLIC_GTM_ENABLED, PUBLIC_COOKIE_CONSENT_ENABLED
# ---------------------------------------------------------------------------
PUBLIC_TAGGING_MODE=

# --- modo direct ---
PUBLIC_GA_ENABLED=false
PUBLIC_GA_ID=
PUBLIC_META_PIXEL_ENABLED=false
# Numérico, do Events Manager da Meta. NÃO é o id do GTM.
PUBLIC_META_PIXEL_ID=

# --- modo gtm ---
# Pode ficar preenchido em modo direct (é ignorado, com aviso no build).
# Container do site anterior: GTM-WK9NJC7W — NÃO ativar antes da auditoria
# (checklist no README).
PUBLIC_GTM_ID=

# Domínio do cookie do CMP. Vazio em dev. Só preencher (.mundoflavinha.com)
# se houver subdomínio que deva herdar a escolha.
PUBLIC_COOKIE_CONSENT_DOMAIN=
