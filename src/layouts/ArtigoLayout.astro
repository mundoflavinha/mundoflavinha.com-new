---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import Newsletter from "@/components/Newsletter.astro";
import { articleJsonLd } from "@/lib/seoJsonLd";
import flaviaGuimaraes from "@/assets/Flavia-Guimaraes.webp";

export interface ArtigoRelacionado {
  title: string;
  category: string;
  image: ImageMetadata;
  href: string;
}

interface Props {
  /** URL canônica absoluta, usada nos links de compartilhamento e no JSON-LD. */
  url: string;
  title: string;
  subtitle: string;
  category: string;
  readingTime: string;
  date: string;
  heroImage: ImageMetadata;
  pullQuote: string;
  paragraphs: string[];
  youtubeUrl: string;
  tags: string[];
  relatedPosts: ArtigoRelacionado[];
  next: { to: string; label: string };
}

const {
  url,
  title,
  subtitle,
  category,
  readingTime,
  date,
  heroImage,
  pullQuote,
  paragraphs,
  youtubeUrl,
  tags,
  relatedPosts,
  next,
} = Astro.props;
---

<Layout
  title={title}
  description={subtitle}
  image={heroImage.src}
  jsonLd={articleJsonLd({ headline: title, description: subtitle, image: heroImage.src, url })}
>
  <article class="bg-background">
    <section class="py-8 md:py-12">
      <div class="container">
        <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
          <a href="/" class="hover:text-primary">Início</a>
          <span>/</span>
          <a href="/blog" class="hover:text-primary">Blog</a>
          <span>/</span>
          <span class="text-primary">{category}</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[1fr_0.92fr] lg:items-center">
          <div>
            <div class="mb-5 flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-2 rounded-full bg-lilac/20 px-4 py-2 text-xs font-heading font-bold uppercase tracking-wide text-primary">
                <Icon name="lucide:heart" class="h-4 w-4" />
                {category}
              </span>
              <span class="inline-flex items-center gap-2 rounded-full bg-baby-blue/25 px-4 py-2 text-sm font-semibold text-foreground/70">
                <Icon name="lucide:clock" class="h-4 w-4 text-primary" />
                {readingTime}
              </span>
            </div>

            <h1 class="max-w-3xl font-heading text-3xl font-bold leading-tight text-foreground md:text-5xl">
              {title}
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">{subtitle}</p>

            <div class="mt-6 flex flex-wrap items-center gap-4">
              <img
                src={flaviaGuimaraes.src}
                width={48}
                height={48}
                alt="Flavia Guimarães"
                class="h-12 w-12 rounded-full object-cover"
              />
              <div>
                <p class="font-heading font-bold text-foreground">Escrito por Flavia Guimarães</p>
                <div class="mt-1 flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="lucide:calendar-days" class="h-4 w-4 text-primary" />
                    {date}
                  </span>
                </div>
              </div>
            </div>

            <div class="mt-6">
              <p class="mb-2 text-sm font-heading font-bold text-foreground">Compartilhe:</p>
              <ShareButtons title={title} url={url} />
            </div>
          </div>

          <div class="overflow-hidden rounded-2xl shadow-lg">
            <img
              src={heroImage.src}
              width={heroImage.width}
              height={heroImage.height}
              alt={title}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="pb-12 md:pb-16">
      <div class="container">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
          <div class="min-w-0">
            <div class="mb-8 rounded-2xl bg-pastel-yellow/25 p-6 text-foreground shadow-sm">
              <p class="font-heading text-lg font-bold text-primary">{pullQuote}</p>
            </div>

            <div class="prose prose-lg max-w-none text-foreground/80 prose-p:leading-relaxed prose-p:my-5 prose-strong:text-foreground">
              {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <div class="mt-8 rounded-2xl border border-baby-blue/40 bg-baby-blue/15 p-5">
              <a
                href={youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 font-heading font-bold text-foreground hover:text-primary"
              >
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary text-primary-foreground">
                  <Icon name="lucide:play" class="h-5 w-5" />
                </span>
                Assistir ao vídeo sobre esse assunto no YouTube
              </a>
            </div>

            <div class="mt-10">
              <div class="mb-3 flex items-center gap-2 font-heading font-bold text-foreground">
                <Icon name="lucide:tag" class="h-5 w-5 text-primary" />
                Assuntos
              </div>
              <div class="flex flex-wrap gap-2">
                {
                  tags.map((tag) => (
                    <span class="rounded-full border border-primary/20 bg-card px-3 py-1 text-sm text-muted-foreground">
                      {tag}
                    </span>
                  ))
                }
              </div>
            </div>

            <div class="mt-10 grid gap-5 rounded-2xl border border-pastel-yellow/70 bg-card p-6 shadow-sm md:grid-cols-[1fr_auto] md:items-center">
              <div class="flex gap-4">
                <img
                  src={flaviaGuimaraes.src}
                  width={64}
                  height={64}
                  alt="Flavia Guimarães"
                  class="h-16 w-16 rounded-full object-cover"
                />
                <div>
                  <h2 class="font-heading text-lg font-bold text-foreground">Sobre a autora</h2>
                  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                    Sou Flavinha, mãe do Lucas e da Bárbara, apaixonada por infância, brincadeiras e por criar
                    memórias afetivas em família.
                  </p>
                  <a href="/sobre" class="mt-2 inline-flex items-center gap-1 text-sm font-heading font-bold text-primary">
                    Saiba mais sobre mim <Icon name="lucide:arrow-right" class="h-3 w-3" />
                  </a>
                </div>
              </div>
              <div>
                <p class="mb-2 text-sm font-heading font-bold text-foreground">Gostou do artigo?</p>
                <p class="mb-3 max-w-xs text-sm text-muted-foreground">
                  Salve para ler depois ou compartilhe com outras famílias!
                </p>
                <ShareButtons title={title} url={url} compact />
              </div>
            </div>

            <div class="mt-8 grid gap-4 border-t border-border pt-6 sm:grid-cols-2">
              <a
                href="/blog"
                class="group flex items-center gap-3 rounded-2xl bg-card p-4 shadow-sm transition-colors hover:bg-secondary/60"
              >
                <Icon name="lucide:arrow-left" class="h-5 w-5 text-primary" />
                <div>
                  <p class="text-sm font-heading font-bold text-primary">Artigo anterior</p>
                  <p class="text-sm text-muted-foreground">Voltar para todos os artigos</p>
                </div>
              </a>
              <a
                href={next.to}
                class="group flex items-center justify-end gap-3 rounded-2xl bg-card p-4 text-right shadow-sm transition-colors hover:bg-secondary/60"
              >
                <div>
                  <p class="text-sm font-heading font-bold text-primary">Próximo artigo</p>
                  <p class="text-sm text-muted-foreground">{next.label}</p>
                </div>
                <Icon name="lucide:arrow-right" class="h-5 w-5 text-primary" />
              </a>
            </div>
          </div>

          <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
            <div class="rounded-2xl border border-primary/15 bg-card p-5 shadow-sm">
              <h2 class="mb-4 flex items-center gap-2 font-heading text-lg font-bold text-foreground">
                <Icon name="lucide:user-round" class="h-5 w-5 text-primary" />
                Leia também
              </h2>
              <div class="space-y-4">
                {
                  relatedPosts.map((post) => (
                    <a
                      href={post.href}
                      class="grid grid-cols-[72px_1fr] gap-3 rounded-xl p-2 transition-colors hover:bg-secondary/50"
                    >
                      <img
                        src={post.image.src}
                        width={72}
                        height={64}
                        alt={post.title}
                        class="h-16 w-[72px] rounded-xl object-cover"
                      />
                      <div>
                        <p class="text-xs font-heading font-bold text-primary">{post.category}</p>
                        <h3 class="mt-1 text-sm font-bold leading-snug text-foreground">{post.title}</h3>
                      </div>
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="rounded-2xl bg-lilac/15 p-5 shadow-sm">
              <h2 class="flex items-center gap-2 font-heading text-lg font-bold text-foreground">
                <Icon name="lucide:mail" class="h-5 w-5 text-primary" />
                Receba conteúdos exclusivos no seu e-mail
              </h2>
              <p class="mt-2 text-sm text-muted-foreground">
                Atividades, dicas e histórias para uma infância com mais conexão.
              </p>
              <Newsletter />
            </div>

            <div class="rounded-2xl bg-mint/20 p-5 shadow-sm">
              <h2 class="mb-3 flex items-center gap-2 font-heading text-lg font-bold text-foreground">
                <Icon name="lucide:bookmark" class="h-5 w-5 text-primary" />
                Compartilhe
              </h2>
              <p class="mb-4 text-sm text-muted-foreground">
                Esse texto pode ajudar outra família a encontrar equilíbrio também.
              </p>
              <ShareButtons title={title} url={url} compact />
            </div>
          </aside>
        </div>
      </div>
    </section>
  </article>
</Layout>
