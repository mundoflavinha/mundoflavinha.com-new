---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página não encontrada" noIndex>
  <section class="container flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="font-heading text-6xl font-bold text-primary">404</p>
    <h1 class="mt-4 font-heading text-2xl font-bold text-foreground md:text-3xl">
      Não encontramos esta página
    </h1>
    <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
      O link pode ter mudado de lugar. Que tal começar pelas brincadeiras?
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-primary px-6 py-2 font-heading font-bold text-primary-foreground transition-opacity hover:opacity-90"
      >
        Voltar para o início
      </a>
      <a
        href="/brincadeiras"
        class="rounded-full border border-primary/30 px-6 py-2 font-heading font-bold text-foreground transition-colors hover:bg-primary/10"
      >
        Ver brincadeiras
      </a>
    </div>
  </section>
</Layout>
