---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import { Icon } from "astro-icon/components";
import aboutFamily from "@/assets/about-family-1.webp";

const values = [
  { icon: "📵", title: "Menos telas", desc: "Acreditamos que as crianças precisam de menos telas e mais presença." },
  { icon: "🎲", title: "Brincar é aprender", desc: "O brincar é a linguagem natural da infância e a melhor forma de aprender." },
  { icon: "💛", title: "Criar memórias", desc: "Cada brincadeira é uma oportunidade de criar memórias que duram para sempre." },
  { icon: "👨‍👩‍👧‍👦", title: "Aproximar famílias", desc: "Queremos inspirar famílias a se conectarem de verdade, com simplicidade e afeto." },
];
---

<Layout
  title="Sobre o Mundo Flavinha"
  description="Conheça a história por trás do Mundo Flavinha, criado por Flávia, mãe do Lucas e da Bárbara, para famílias que querem mais presença e menos telas."
>
  <section class="relative bg-secondary py-12 md:py-20">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-8 items-center">
        <div>
          <h1 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl text-foreground">
            Sobre o <span class="text-primary">Mundo Flavinha</span>
          </h1>
          <div class="mt-5 flex items-center gap-2">
            <span class="w-8 h-1 rounded-full bg-pink"></span>
            <span class="w-3 h-3 rounded-full bg-lilac"></span>
            <span class="w-8 h-1 rounded-full bg-baby-blue"></span>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img
            src={aboutFamily.src}
            width={aboutFamily.width}
            height={aboutFamily.height}
            alt="Flávia com Lucas e Bárbara"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container max-w-3xl">
      <div class="prose prose-lg mx-auto text-foreground/80">
        <p class="text-lg leading-relaxed">
          O <strong class="text-foreground">Mundo Flavinha</strong> nasceu do desejo de uma mãe de oferecer mais
          conexão, mais brincadeira e mais presença na vida dos seus filhos.
        </p>
        <p class="leading-relaxed">
          Sou Flávia, mãe do Lucas e da Bárbara. Quando me tornei mãe, percebi que o mundo corria cada vez mais
          rápido, e que as telas estavam ocupando um espaço enorme na vida das crianças — e na nossa também.
        </p>
        <p class="leading-relaxed">
          Foi então que decidi transformar o nosso dia a dia em um laboratório de brincadeiras, descobertas e
          momentos simples, mas cheios de significado. O que começou em casa virou conteúdo, virou comunidade,
          virou o Mundo Flavinha.
        </p>
        <p class="leading-relaxed">
          Aqui, você vai encontrar brincadeiras para todas as idades, materiais para download, vídeos, dicas e
          muita inspiração para criar memórias afetivas com seus filhos. Porque acredito que infância é coisa
          séria — e merece ser vivida com mais presença e menos telas.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-secondary/50">
    <div class="container">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-center text-foreground mb-8">Nossos valores</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          values.map((v) => (
            <div class="bg-card rounded-2xl p-6 text-center shadow-sm">
              <div class="text-4xl mb-3">{v.icon}</div>
              <h3 class="font-heading font-bold text-foreground">{v.title}</h3>
              <p class="text-sm text-muted-foreground mt-2">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container text-center">
      <Icon name="lucide:heart" class="w-10 h-10 text-pink mx-auto mb-4" />
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground">Explore o Mundo Flavinha</h2>
      <p class="text-muted-foreground mt-3 max-w-lg mx-auto">
        Descubra brincadeiras, baixe materiais gratuitos, assista vídeos e encontre tudo que você precisa para
        brincar mais em família.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href="/brincadeiras" class="rounded-full bg-primary text-primary-foreground font-heading font-bold gap-2">
          <Icon name="lucide:star" class="w-4 h-4" /> Ver brincadeiras
        </Button>
        <Button
          href="/downloads"
          variant="outline"
          class="rounded-full font-heading font-bold border-primary/30 text-foreground gap-2"
        >
          Baixar materiais <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </Button>
      </div>
    </div>
  </section>
</Layout>
