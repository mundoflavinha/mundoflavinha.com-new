---
import Layout from "@/layouts/Layout.astro";
import PageBanner from "@/components/PageBanner.astro";
import Button from "@/components/Button.astro";
import { Icon } from "astro-icon/components";
import { products } from "@/data/achadinhosFamilia";

const benefitHighlights = [
  { label: "Conexão Familiar", icon: "lucide:heart" },
  { label: "Raciocínio Lógico", icon: "lucide:brain" },
  { label: "Criatividade", icon: "lucide:sparkles" },
  { label: "Comunicação", icon: "lucide:message-circle" },
  { label: "Estratégia", icon: "lucide:puzzle" },
];

const featuredProducts = products.slice(0, 3);
---

<Layout
  title="Jogos para Brincar em Família"
  description="Momentos de conexão, risadas e memórias longe das telas."
>
  <PageBanner
    title="Jogos para Brincar em Família"
    subtitle="Momentos de conexão, risadas e memórias longe das telas."
    bgColor="bg-secondary"
  />

  <section class="py-8 md:py-10 bg-background">
    <div class="container">
      <div class="grid lg:grid-cols-[1fr_0.9fr] gap-6 items-start">
        <div class="rounded-3xl bg-card border border-border p-5 md:p-6 shadow-soft">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {
              benefitHighlights.map(({ label, icon }) => (
                <div class="flex items-center gap-3 rounded-2xl bg-secondary px-4 py-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground">
                    <Icon name={icon} class="h-5 w-5" />
                  </span>
                  <span class="font-heading font-semibold text-sm text-foreground">{label}</span>
                </div>
              ))
            }
          </div>
          <div class="mt-5 flex flex-col sm:flex-row sm:items-center gap-3">
            <p class="font-heading font-bold text-xl text-foreground">Veja os jogos recomendados</p>
            <Button href="#produtos" class="sm:ml-auto rounded-full font-heading">
              Ver todos os jogos
              <Icon name="lucide:arrow-down" class="ml-2 h-4 w-4" />
            </Button>
          </div>
        </div>

        <div class="rounded-3xl bg-lilac/15 border border-lilac/25 p-5 md:p-6">
          <p class="text-sm font-heading font-bold text-primary">Selecionados por Flavinha</p>
          <h2 class="mt-2 font-heading font-bold text-2xl text-foreground">Favoritos das famílias</h2>
          <div class="mt-4 grid grid-cols-3 gap-3">
            {
              featuredProducts.map((product) => (
                <div class="overflow-hidden rounded-2xl bg-white shadow-soft">
                  <img
                    src={product.image.src}
                    width={product.image.width}
                    height={product.image.height}
                    alt={product.title}
                    class="h-28 w-full object-contain p-2"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-8 grid lg:grid-cols-[1fr_0.9fr] gap-6">
        <div>
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground">Por que investir em jogos em família?</h2>
          <div class="mt-4 space-y-3 text-muted-foreground leading-relaxed">
            <p>
              Jogos de tabuleiro, cartas e desafios em grupo são uma forma simples de reunir a família, diminuir o
              excesso de telas e criar momentos de presença de verdade.
            </p>
            <p>
              Além da diversão, eles ajudam as crianças a esperar a vez, lidar com regras, conversar, pensar em
              estratégias e conviver melhor com vitórias e frustrações.
            </p>
            <p>
              Cada indicação desta página foi pensada para transformar o tempo juntos em aprendizado, afeto e boas
              memórias.
            </p>
          </div>
        </div>
        <div class="rounded-3xl bg-primary/10 border border-primary/20 p-5 md:p-6">
          <h3 class="font-heading font-bold text-xl text-foreground">O que os jogos em família desenvolvem?</h3>
          <ul class="mt-4 grid sm:grid-cols-2 gap-3 text-sm font-medium text-foreground">
            <li class="rounded-2xl bg-white/70 px-4 py-3">Convivência e vínculo</li>
            <li class="rounded-2xl bg-white/70 px-4 py-3">Comunicação</li>
            <li class="rounded-2xl bg-white/70 px-4 py-3">Raciocínio lógico</li>
            <li class="rounded-2xl bg-white/70 px-4 py-3">Estratégia</li>
            <li class="rounded-2xl bg-white/70 px-4 py-3">Criatividade</li>
            <li class="rounded-2xl bg-white/70 px-4 py-3">Memórias afetivas</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="produtos" class="py-12 md:py-16 bg-secondary/40">
    <div class="container">
      <div class="mb-8 text-center">
        <p class="text-sm font-heading font-bold text-primary">Achadinhos da Flavinha</p>
        <h2 class="mt-2 font-heading font-bold text-3xl text-foreground">Jogos recomendados</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {
          products.map((product) => (
            <article class="reveal flex h-full flex-col overflow-hidden rounded-3xl bg-card border border-border shadow-soft">
              <div class="aspect-square bg-white">
                <img
                  src={product.image.src}
                  width={product.image.width}
                  height={product.image.height}
                  alt={product.title}
                  class="h-full w-full object-contain p-4"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-heading font-bold text-xl text-foreground">{product.title}</h3>
                <p class="mt-2 font-heading font-semibold text-primary">{product.eyebrow}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{product.description}</p>
                <div class="mt-4 inline-flex w-fit items-center gap-2 rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-foreground">
                  <Icon name="lucide:users" class="h-3.5 w-3.5 text-primary" />
                  Indicado: {product.recommendedAge}
                </div>
                <Button
                  href={product.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto w-full rounded-full font-heading"
                >
                  Ver mais
                  <Icon name="lucide:external-link" class="ml-2 h-4 w-4" />
                </Button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
