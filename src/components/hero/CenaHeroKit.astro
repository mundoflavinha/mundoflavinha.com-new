---
import PecaKit from "./PecaKit.astro";

/**
 * Composição do hero com o "Hero SVG Kit".
 *
 * Segue a direção do README do kit: blob coral atrás da família e blob lilás
 * deslocado para direita/baixo; avião, nuvem e trilha na faixa superior;
 * dado, giz, estrela, quebra-cabeça e massinha no primeiro plano, junto à base
 * do recorte. Rostos, mãos e o CTA ficam livres.
 *
 * A foto entra por <slot> e não direto aqui: ela é CONTEÚDO (tem alt, é o LCP)
 * e pertence ao HeroHome; o que este componente detém é o empilhamento. Assim
 * a ordem das camadas mora num lugar só, em vez de ficar dividida entre dois
 * arquivos que precisam concordar sobre z-index.
 *
 * As peças que o README manda cortar primeiro em tela pequena — wooden-block,
 * heart-doodle e scribble-purple — saem com `hidden sm:block`.
 *
 * As da borda esquerda (avião, nuvem, flor, orbit-dot) sangram de propósito no
 * desktop, onde a coluna tem o container em volta. No celular a caixa é
 * full-bleed (`-mx-6`) e "para fora" passa a ser "cortado na borda da tela",
 * então elas entram até `lg`.
 */

/**
 * `superficie` controla o que apoia a família. Existe porque a pose é
 * SUSPENSA — todos os pés estão em ponta, ninguém pisa em nada — e um plano de
 * chão em perspectiva entra em contradição com ela. Ver as variantes em
 * /variantes-hero.
 */
export type Superficie = "tapete" | "tapete-recuado" | "poca" | "nenhuma";

interface Props {
  class?: string;
  superficie?: Superficie;
}

const { class: className, superficie = "tapete" } = Astro.props;
---

<div class:list={["mf-hero-art", className]}>
  {/* ---------- fundo ---------- */}
  <PecaKit nome="blob-lilac" class="left-[33%] top-[23%] z-0 w-[63%]" motion="breathe-slow" />
  <PecaKit nome="blob-coral" class="left-[7%] top-[0%] z-10 w-[82%]" motion="breathe" />

  {/* ---------- rabiscos, atrás da família ---------- */}
  <PecaKit nome="motion-path" class="left-[13%] top-[9%] z-20 w-[42%]" />
  <PecaKit nome="cloud-doodle" class="left-[2%] top-[27%] z-20 w-[18%] lg:left-[-1%]" motion="float-a" delay="-2.4s" />
  <PecaKit nome="paper-plane" class="left-[3%] top-[3%] z-20 w-[23%] lg:left-[-3%]" motion="plane-drift" />
  <PecaKit nome="spark-lines" class="left-[70%] top-[1%] z-20 w-[11%]" motion="twinkle" delay="-1.2s" />
  <PecaKit nome="heart-doodle" class="left-[84%] top-[5%] z-20 hidden w-[13%] sm:block" motion="twinkle" delay="-2.8s" />
  <PecaKit nome="sparkle" class="left-[88%] top-[43%] z-20 w-[9%]" motion="twinkle" delay="-0.6s" />
  <PecaKit nome="orbit-dot" class="left-[2%] top-[52%] z-20 w-[7%] lg:left-[0%]" motion="orbit" />
  <PecaKit nome="scribble-purple" class="left-[55%] top-[94%] z-20 hidden w-[24%] sm:block" motion="sway" delay="-1.8s" />
  <PecaKit nome="flower-doodle" class="left-[2%] top-[79%] z-20 w-[16%] lg:left-[-3%]" motion="sway" />

  {/*
    SUPERFÍCIE — ponto de troca.

    Na referência o tapete não é um elemento à parte: é a própria fotografia,
    e o recorte que usamos apagou ele. Este é o substituto vetorial, na
    perspectiva medida do original (elipse 0,30). Quando o recorte fotográfico
    do tapete chegar, troca-se ESTA peça por um <img> no mesmo lugar — a
    posição já está calibrada contra a faixa de contato do recorte e nada mais
    na composição precisa mudar.

    Onde ele fica não é palpite: medindo o alpha do recorte, a base só encosta
    no chão entre 35% e 88% da largura (o resto são os braços do Lucas e da
    Bárbara, no ar), com a base entre 84% e 95% da altura. Convertido para a
    caixa da arte, isso dá o miolo em x 41–75% e a linha de contato em y 66–74%
    — daí o tapete centrado em x 59% (o meio da faixa de contato é 58,4%) e
    com a borda frontal em 81%, deixando uma margem de palha à frente dos pés.
  */}
  {superficie === "tapete" && <PecaKit nome="rug-jute" class="left-[16%] top-[56%] z-[5] w-[88%]" />}
  {superficie === "tapete-recuado" && (
    <PecaKit nome="rug-jute" class="left-[19%] top-[50%] z-[5] w-[84%] opacity-70" />
  )}
  {superficie === "poca" && <PecaKit nome="pool-sand" class="left-[14%] top-[60%] z-[5] w-[86%]" />}

  {/*
    Sombra de contato, sobre o tapete (z-20) e sob a foto (z-30).

    Ela precisa VAZAR para baixo do recorte para existir: medido no navegador,
    a versão anterior terminava no mesmo pixel em que a foto termina, então
    ficava 100% coberta por ela e não pintava nada. Agora começa acima dos pés
    e sai por baixo deles, que é o único pedaço onde uma sombra de contato tem
    o que mostrar.
  */}
  {superficie !== "nenhuma" && (
    <div class="absolute left-[35%] top-[73%] z-20 h-[9%] w-[44%] rounded-[50%] bg-[#6b4a2a]/30 blur-lg" />
  )}

  {/* ---------- família ---------- */}
  <div class="absolute inset-0 z-30">
    <slot />
  </div>

  {/* ---------- brinquedos, na frente ---------- */}
  <PecaKit nome="wooden-block" class="left-[86%] top-[14%] z-40 hidden w-[13%] sm:block" motion="float-b" delay="-3.1s" />
  <PecaKit nome="clay-ball-mint" class="left-[85%] top-[64%] z-40 w-[12%]" motion="float-b" delay="-1.5s" />
  <PecaKit nome="jigsaw-pink" class="left-[63%] top-[80%] z-40 w-[16%]" motion="wobble" delay="-3.6s" />
  <PecaKit nome="star-yellow" class="left-[46%] top-[88%] z-40 w-[11%]" motion="twinkle" delay="-1.9s" />
  <PecaKit nome="dice-purple" class="left-[3%] top-[67%] z-40 w-[13%]" motion="wobble" />
  <PecaKit nome="crayon-coral" class="left-[16%] top-[85%] z-40 w-[27%]" motion="float-a" delay="-2.2s" />
</div>
