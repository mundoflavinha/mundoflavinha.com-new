---
import { Icon } from "astro-icon/components";

/**
 * Player do YouTube com "facade": até o clique, nada é carregado do Google.
 *
 * Porta o YouTubeEmbed.tsx sem virar ilha — era um componente React inteiro a
 * serviço de um único `useState` booleano. Aqui são ~10 linhas de JS.
 *
 * Por que importa: um <iframe> do YouTube montado junto com a página faz o
 * navegador do visitante contatar o Google — e receber cookies de terceiros —
 * mesmo de quem nunca quis assistir. Com o facade, isso só acontece por escolha
 * de quem visita. Usamos youtube-nocookie.com, o modo de privacidade ampliada.
 *
 * INTERINO: na Fase 5 o `iframemanager` (companheiro do vanilla-cookieconsent)
 * assume este papel e amarra a ativação à categoria de consentimento aceita,
 * em vez de só adiar o contato até o clique.
 */

interface Props {
  videoId: string;
  title: string;
  /** Segundo em que o vídeo começa. */
  start?: number;
  class?: string;
}

const { videoId, title, start, class: className = "" } = Astro.props;

const params = new URLSearchParams({ autoplay: "1", rel: "0" });
if (start) params.set("start", String(start));
const src = `https://www.youtube-nocookie.com/embed/${videoId}?${params.toString()}`;
---

<button
  type="button"
  data-youtube-facade
  data-src={src}
  data-title={title}
  data-classe-iframe={className}
  aria-label={`Assistir: ${title}`}
  class:list={[
    "group relative flex flex-col items-center justify-center gap-3 bg-gradient-to-br from-lilac/30 via-pink/25 to-baby-blue/30 transition-colors hover:from-lilac/40 hover:via-pink/35 hover:to-baby-blue/40",
    className,
  ]}
>
  <span class="flex h-16 w-16 items-center justify-center rounded-full bg-card shadow-lg transition-transform group-hover:scale-110">
    <Icon name="lucide:play" class="ml-1 h-7 w-7 text-primary" />
  </span>
  <span class="max-w-[80%] text-center font-heading text-sm font-bold text-foreground md:text-base">
    {title}
  </span>
  <span class="text-xs text-foreground/60">Clique para assistir no YouTube</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-youtube-facade]").forEach((botao) => {
    botao.addEventListener(
      "click",
      () => {
        const iframe = document.createElement("iframe");
        iframe.src = botao.dataset.src ?? "";
        iframe.title = botao.dataset.title ?? "";
        // Só as classes de dimensão, como no React original: o gradiente e o
        // layout de centralização eram do botão, não do player.
        iframe.className = botao.dataset.classeIframe ?? "";
        iframe.allow = "autoplay; encrypted-media; picture-in-picture";
        iframe.allowFullscreen = true;
        botao.replaceWith(iframe);
      },
      { once: true },
    );
  });
</script>
