---
/**
 * Banner e painel de preferências de cookies.
 *
 * Sem `define:vars` e sem `is:inline` de propósito: qualquer atributo faz o
 * Astro tratar o `<script>` como inline, e script inline NÃO resolve import de
 * pacote npm — `import("vanilla-cookieconsent")` viraria um especificador nu no
 * navegador e quebraria em runtime, com o build passando. Como este script é
 * processado, ele importa direto do catálogo em TypeScript e o Astro empacota
 * biblioteca e CSS servindo pelo nosso domínio.
 *
 * Nada de CDN: o gerenciador roda ANTES de qualquer escolha, então buscá-lo num
 * terceiro criaria justamente a comunicação prévia que ele existe para evitar.
 */
---

<script>
  import "vanilla-cookieconsent/dist/cookieconsent.css";
  import * as CookieConsent from "vanilla-cookieconsent";
  import { CATEGORIAS_COOKIES, NOME_DO_COOKIE_DE_CONSENTIMENTO, REVISAO_COOKIES } from "@/lib/cookies";
  import { ROTAS_LEGAIS } from "@/lib/site";
  import { initConsent } from "@/lib/tagging";
  import { DOMINIO_DO_COOKIE } from "@/lib/tagging/config";

  /*
   * `enableMarketing: true` porque o site é uma superfície só, pública, sem
   * área logada. O dia em que existir uma (app., painel.), ela chama
   * `initConsent({ enableMarketing: false })` — o cookie de consentimento é
   * compartilhável entre subdomínios, e sem esse flag quem aceitasse
   * publicidade aqui levaria o Pixel para dentro de uma tela com dado pessoal.
   *
   * Com PUBLIC_TAGGING_MODE=disabled os handlers existem mas o adaptador é
   * no-op: o banner continua funcionando (o YouTube depende dele).
   */
  const tags = initConsent({ enableMarketing: true });

  // O cookie do CMP mudou de nome (cc_cookie → NOME_DO_COOKIE_DE_CONSENTIMENTO)
  // junto com a revisão 3. O antigo não vale mais como escolha e ficaria órfão
  // no navegador de quem visitou antes; apagar é só limpeza do que o próprio
  // site gravou.
  document.cookie = `cc_cookie=; Max-Age=0; path=/; domain=${window.location.hostname}`;
  document.cookie = "cc_cookie=; Max-Age=0; path=/";

  const categorias = Object.fromEntries(
    CATEGORIAS_COOKIES.map((c) => {
      if (c.obrigatoria) return [c.id, { enabled: true, readOnly: true }];

      // `autoClear` derivado do próprio catálogo: recusar ou revogar tem que
      // APAGAR o que já foi gravado, não só parar de gravar. Sem os padrões
      // aqui, `autoClearCookies` não tem o que casar e o identificador já
      // criado sobrevive à revogação.
      const padroes = c.cookies.filter((k) => k.padrao).map((k) => ({ name: k.padrao! }));
      return [c.id, padroes.length > 0 ? { autoClear: { cookies: padroes } } : {}];
    }),
  );

  const secoes = CATEGORIAS_COOKIES.map((c) => ({
    title: c.titulo,
    description: c.descricao,
    linkedCategory: c.id,
  }));

  CookieConsent.run({
    // opt-in: nada opcional roda antes do aceite. É o padrão da biblioteca,
    // declarado aqui de propósito — silêncio não é consentimento.
    mode: "opt-in",
    revision: REVISAO_COOKIES,

    cookie: {
      name: NOME_DO_COOKIE_DE_CONSENTIMENTO,
      // Vazio = hostname atual. Só vira `.mundoflavinha.com` se um dia houver
      // subdomínio que deva herdar a escolha; em dev tem que ficar vazio,
      // senão o cookie não grava em localhost.
      domain: DOMINIO_DO_COOKIE || window.location.hostname,
      path: "/",
      sameSite: "Lax",
      secure: window.location.protocol === "https:",
      expiresAfterDays: 365,
      // localStorage é origin-scoped: não atravessa subdomínio, e some em
      // navegação privativa de um jeito que o cookie não some. A escolha sobre
      // cookies não pode depender de um mecanismo mais frágil que o cookie.
      useLocalStorage: false,
    },

    // Com o Analytics no jogo, passa a existir coleta que começaria sozinha, sem
    // nenhuma ação da pessoa — então a pergunta tem que vir na frente. Enquanto
    // não havia analytics, o banner ficava desligado: o site não carregava nada
    // de terceiro por conta própria e perguntar sem ter o que coletar é ruído.
    autoShow: true,

    manageScriptTags: true,
    autoClearCookies: true,

    // Desligado de propósito. O padrão é `true` e faz a biblioteca ABORTAR por
    // inteiro quando detecta automação — inclusive `navigator.webdriver`. O que
    // ele protege é o crawler indexar o texto do banner — coisa que o próprio
    // `hideFromBots` só evita se o crawler for detectado, e que custa caro
    // quando falha: com a biblioteca abortada, o botão do vídeo fica morto e
    // sem explicação, e o banner nunca aparece para quem foi confundido com um
    // robô. O texto do banner ser indexado é um problema menor que o site
    // parecer quebrado. Ver o fallback em YouTubeFacade.astro.
    hideFromBots: false,
    // Nunca bloquear a página: seria um cookie wall, e recusar não pode custar
    // o acesso ao conteúdo.
    disablePageInteraction: false,

    guiOptions: {
      consentModal: { layout: "box", position: "bottom right", equalWeightButtons: true },
      preferencesModal: { layout: "box", equalWeightButtons: true },
    },

    categories: categorias,

    /*
     * Injeção das tags. `onConsent` cobre a decisão já gravada em visitas
     * anteriores; `onChange`, a mudança feita agora no painel — sem ele,
     * revogar só valeria no próximo reload, e revogar que exige recarregar
     * não é revogar.
     */
    onConsent: tags.onConsent,
    onChange: tags.onChange,

    language: {
      default: "pt",
      translations: {
        pt: {
          consentModal: {
            title: "Cookies e conteúdo externo",
            description:
              "Usamos cookies para medir o uso do site (Google Analytics), para avaliar nossos anúncios na Meta (Facebook e Instagram) e para carregar os vídeos do YouTube. Nada disso roda antes de você permitir, e recusar não tira nenhum conteúdo do ar.",
            acceptAllBtn: "Aceitar tudo",
            // Rótulo explícito: "Continuar sem aceitar" não deixa claro que é
            // uma recusa, e recusar tem que ser tão evidente quanto aceitar.
            acceptNecessaryBtn: "Recusar o que não é necessário",
            showPreferencesBtn: "Escolher o que permitir",
          },
          preferencesModal: {
            title: "Suas preferências",
            acceptAllBtn: "Aceitar tudo",
            acceptNecessaryBtn: "Recusar o que não é necessário",
            savePreferencesBtn: "Salvar minhas escolhas",
            closeIconLabel: "Fechar",
            sections: [
              {
                description: `Você pode mudar isto quando quiser. Os detalhes estão na <a href="${ROTAS_LEGAIS.privacidade}#cookies" class="cc__link">Política de Privacidade</a>.`,
              },
              ...secoes,
            ],
          },
        },
      },
    },
  });

  // Reemitido como evento de janela para o facade de vídeo reagir sem recarregar
  // a página. Quem aceita pelo painel não deveria ter que caçar o que mudou.
  // Em WINDOW, não em document: a biblioteca chama `dispatchEvent` nu dentro do
  // módulo, o que resolve para window.dispatchEvent. Ouvir em document não
  // recebia nada — e a falha era silenciosa, com o player simplesmente não
  // aparecendo depois do aceite.
  const avisar = () => window.dispatchEvent(new CustomEvent("mundoflavinha:consentimento"));
  window.addEventListener("cc:onConsent", avisar);
  window.addEventListener("cc:onChange", avisar);

  // Link fixo do rodapé: revogar tão fácil quanto aceitar.
  document.querySelectorAll("[data-abrir-preferencias]").forEach((botao) =>
    botao.addEventListener("click", (evento) => {
      evento.preventDefault();
      CookieConsent.showPreferences();
    }),
  );
</script>

<style is:global>
  /*
   * A biblioteca só expõe tema via variáveis CSS (--cc-*), sem esquema de
   * cores próprio — por padrão sai cinza-chumbo genérico, destoando do resto
   * do site. Mapeando para os tokens de src/styles/global.css (mesmos nomes
   * usados pelo Tailwind via hsl(var(--x))), o banner e o painel de
   * preferências (que reaproveitam as mesmas variáveis de botão) herdam a
   * paleta e a tipografia do site automaticamente.
   */
  #cc-main {
    --cc-font-family: var(--font-body);
    --cc-bg: hsl(var(--card));
    --cc-primary-color: hsl(var(--foreground));
    --cc-secondary-color: hsl(var(--muted-foreground));
    --cc-modal-border-radius: var(--radius);
    --cc-btn-border-radius: 9999px;
    --cc-separator-border-color: hsl(var(--border));

    /* "Aceitar" e "Recusar" usam a mesma variável de propósito — o código
       pede equalWeightButtons porque recusar tem que parecer tão legítimo
       quanto aceitar, não uma opção secundária. */
    --cc-btn-primary-bg: hsl(var(--primary));
    --cc-btn-primary-color: hsl(var(--primary-foreground));
    --cc-btn-primary-border-color: hsl(var(--primary));
    --cc-btn-primary-hover-bg: hsl(var(--primary) / 0.88);
    --cc-btn-primary-hover-color: hsl(var(--primary-foreground));
    --cc-btn-primary-hover-border-color: hsl(var(--primary) / 0.88);

    --cc-btn-secondary-bg: hsl(var(--secondary));
    --cc-btn-secondary-color: hsl(var(--secondary-foreground));
    --cc-btn-secondary-border-color: hsl(var(--secondary));
    --cc-btn-secondary-hover-bg: hsl(var(--secondary) / 0.75);
    --cc-btn-secondary-hover-color: hsl(var(--secondary-foreground));
    --cc-btn-secondary-hover-border-color: hsl(var(--secondary) / 0.75);

    /* Estas três dependem de --cc-btn-primary-* por var() indireto, mas a
       biblioteca as declara no :root dela — fora do escopo de #cc-main. Como
       propriedade customizada herda o valor JÁ RESOLVIDO no ancestral (não a
       referência), repetir aqui é necessário; senão ficam presas no cinza
       padrão mesmo com --cc-btn-primary-bg sobrescrito acima. */
    --cc-toggle-on-bg: hsl(var(--primary));
    --cc-link-color: hsl(var(--primary));
    --cc-webkit-scrollbar-hover-bg: hsl(var(--primary) / 0.88);
  }

  #cc-main .cm__title,
  #cc-main .pm__title {
    font-family: var(--font-heading);
  }
</style>
