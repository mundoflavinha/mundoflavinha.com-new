---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  url: string;
  compact?: boolean;
}

const { title, url, compact = false } = Astro.props;

const shareLinks = [
  { label: "WhatsApp", icon: "lucide:message-circle", href: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}` },
  { label: "Facebook", icon: "lucide:send", href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}` },
  { label: "Instagram", icon: "lucide:heart", href: "https://www.instagram.com/" },
  { label: "Copiar link", icon: "lucide:link-2", href: url },
];

const tamanho = compact ? "h-9 w-9" : "h-10 w-10";
---

<div class="flex flex-wrap items-center gap-2">
  {
    shareLinks.map((item) => (
      <a
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={item.label}
        class:list={[
          "inline-flex items-center justify-center rounded-full border border-primary/20 bg-card text-primary transition-colors hover:bg-primary hover:text-primary-foreground",
          tamanho,
        ]}
      >
        <Icon name={item.icon} class="h-4 w-4" />
      </a>
    ))
  }
</div>
