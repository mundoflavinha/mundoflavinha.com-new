---
interface Props {
  id: string;
  title: string;
  /** Ausente quando o documento tem uma seção só (ex.: Contato). */
  numero?: number;
}
const { id, title, numero } = Astro.props;
---

<section id={id} class="scroll-mt-24">
  <h2 class="font-heading text-xl font-bold text-foreground md:text-2xl">
    {numero !== undefined && <span class="text-primary">{numero}. </span>}{title}
  </h2>
  <div class="mt-3 space-y-3 text-foreground/80"><slot /></div>
</section>
