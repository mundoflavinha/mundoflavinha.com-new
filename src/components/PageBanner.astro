---
interface Props {
  title: string;
  subtitle?: string;
  bgColor?: string;
}

const { title, subtitle, bgColor = "bg-secondary" } = Astro.props;
---

<section class:list={[bgColor, "py-12 md:py-20"]}>
  <div class="container text-center">
    <h1 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl text-foreground">
      {title}
    </h1>
    {subtitle && <p class="mt-4 text-muted-foreground max-w-2xl mx-auto leading-relaxed">{subtitle}</p>}
    <div class="mt-5 flex items-center justify-center gap-2">
      <span class="w-8 h-1 rounded-full bg-pink"></span>
      <span class="w-3 h-3 rounded-full bg-lilac"></span>
      <span class="w-8 h-1 rounded-full bg-baby-blue"></span>
    </div>
  </div>
</section>
