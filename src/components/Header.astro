---
import { Icon } from "astro-icon/components";
import logo from "@/assets/logo_01.webp";

/**
 * Deixou de ser componente React de propósito.
 *
 * O Header está nas 31 rotas: virar island custaria React + ReactDOM no
 * caminho crítico de toda página só por causa de um booleano de menu aberto.
 * Metade da interatividade sumiu sozinha na migração — `useLocation` virou
 * `Astro.url.pathname`, resolvido no build, então `aria-current` e o realce da
 * rota ativa agora são HTML estático. Sobrou o toggle, em ~15 linhas de JS.
 */

const navItems = [
  { label: "Início", path: "/" },
  { label: "Brincadeiras", path: "/brincadeiras" },
  { label: "Downloads", path: "/downloads" },
  { label: "Vídeos", path: "/videos" },
  { label: "Blog", path: "/blog" },
  { label: "Achadinhos", path: "/indicacoes" },
  { label: "Loja", path: "/loja" },
  { label: "Sobre", path: "/sobre" },
];

const rotaAtual = Astro.url.pathname;
const ehHome = rotaAtual === "/";
const ativo = (path: string) => rotaAtual === path;
---

<header
  class="sticky top-0 z-50 bg-card/95 backdrop-blur-md border-b border-border shadow-sm"
>
  <div class="container flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center gap-2">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="Mundo Flavinha"
        class="h-12 md:h-14 w-auto"
      />
    </a>

    <nav aria-label="Navegação principal" class="hidden lg:flex items-center gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            aria-current={ativo(item.path) ? "page" : undefined}
            class:list={[
              "px-3 py-2 rounded-lg text-sm font-heading font-semibold transition-colors hover:bg-secondary",
              ativo(item.path) ? "text-primary bg-secondary" : "text-foreground/70 hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    {
      !ehHome && (
        <div class="hidden lg:flex items-center gap-3">
          <a
            href="/downloads"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-heading font-bold text-primary-foreground transition-opacity hover:opacity-90"
          >
            <Icon name="lucide:download" class="w-4 h-4" />
            Baixar atividade gratuita
          </a>
        </div>
      )
    }

    <button
      type="button"
      id="botao-menu"
      class="lg:hidden p-2 rounded-lg hover:bg-secondary transition-colors text-foreground"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <Icon name="lucide:menu" class="w-6 h-6" data-icone="abrir" />
      <Icon name="lucide:x" class="w-6 h-6 hidden" data-icone="fechar" />
    </button>
  </div>

  <div id="menu-mobile" class="lg:hidden bg-card border-t border-border hidden">
    <nav aria-label="Navegação principal" class="container py-4 flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            aria-current={ativo(item.path) ? "page" : undefined}
            class:list={[
              "px-4 py-3 rounded-lg font-heading font-semibold transition-colors",
              ativo(item.path) ? "text-primary bg-secondary" : "text-foreground/70 hover:bg-secondary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      {
        !ehHome && (
          <a
            href="/downloads"
            class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-4 py-2 font-heading font-bold text-primary-foreground transition-opacity hover:opacity-90"
          >
            <Icon name="lucide:download" class="w-4 h-4" />
            Baixar atividade gratuita
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const botao = document.getElementById("botao-menu");
  const menu = document.getElementById("menu-mobile");

  if (botao && menu) {
    const iconeAbrir = botao.querySelector<SVGElement>('[data-icone="abrir"]');
    const iconeFechar = botao.querySelector<SVGElement>('[data-icone="fechar"]');

    botao.addEventListener("click", () => {
      const aberto = botao.getAttribute("aria-expanded") === "true";
      const proximo = !aberto;

      botao.setAttribute("aria-expanded", String(proximo));
      botao.setAttribute("aria-label", proximo ? "Fechar menu" : "Abrir menu");
      menu.classList.toggle("hidden", !proximo);
      iconeAbrir?.classList.toggle("hidden", proximo);
      iconeFechar?.classList.toggle("hidden", !proximo);
    });
  }
</script>
