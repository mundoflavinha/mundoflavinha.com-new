---
import { Icon } from "astro-icon/components";
import logo from "@/assets/logo_01.webp";
import BuscaHeader from "@/components/hero/BuscaHeader.astro";

/**
 * Deixou de ser componente React de propósito.
 *
 * O Header está nas 31 rotas: virar island custaria React + ReactDOM no
 * caminho crítico de toda página só por causa de um booleano de menu aberto.
 * Metade da interatividade sumiu sozinha na migração — `useLocation` virou
 * `Astro.url.pathname`, resolvido no build, então `aria-current` e o realce da
 * rota ativa agora são HTML estático. Sobrou o toggle, em ~15 linhas de JS.
 *
 * ------------------------------------------------------------------
 * Redesign (ref. _tmp/header_ref.png)
 *
 * Na home o header flutua sobre o creme do hero, sem barra nem borda — é o que
 * a referência mostra. Isso exige que ele seja transparente no topo e ganhe
 * fundo ao rolar, senão o texto do menu passa por cima do conteúdo da página.
 * Nas outras 30 rotas, que não foram redesenhadas, ele nasce sólido: seria
 * transparente sobre um <main> branco qualquer.
 *
 * "Início" saiu do menu — o logo já leva para a home e a referência mostra a
 * barra sem ele. "Loja" saiu depois, a pedido — a rota /loja continua no ar,
 * só não tem mais entrada na barra.
 */

const navItems = [
  { label: "Brincadeiras", path: "/brincadeiras" },
  { label: "Downloads", path: "/downloads" },
  { label: "Vídeos", path: "/videos" },
  { label: "Blog", path: "/blog" },
  { label: "Achadinhos", path: "/indicacoes" },
  { label: "Sobre", path: "/sobre" },
];

const rotaAtual = Astro.url.pathname;
const ehHome = rotaAtual === "/";
const ativo = (path: string) => rotaAtual === path || rotaAtual.startsWith(`${path}/`);
---

<header
  data-cabecalho
  data-sobreposto={ehHome ? "true" : undefined}
  class:list={[
    "sticky top-0 z-50 transition-[background-color,box-shadow,backdrop-filter] duration-300",
    /*
     * Na home o header é CREME, não transparente. Transparente deixava uma
     * faixa branca no topo: ele é `sticky`, então ocupa espaço no fluxo ANTES
     * da seção do hero, e o que aparecia atrás dele era o `--background` do
     * body, não o creme do hero. A emenda ficava visível na largura inteira.
     * Pintar da mesma cor do hero resolve sem puxar a seção com margem
     * negativa. Ao rolar, só entram sombra e blur para descolar do conteúdo.
     *
     * Fora da home não há hero creme atrás: nasce sólido.
     */
    ehHome
      ? "bg-creme data-[rolado=true]:bg-creme/90 data-[rolado=true]:shadow-[0_8px_28px_-12px_rgba(45,20,70,0.28)] data-[rolado=true]:backdrop-blur-md"
      : "border-b border-border bg-card/95 shadow-sm backdrop-blur-md",
  ]}
>
  <div class="container flex h-20 items-center justify-between gap-4 md:h-24">
    <a href="/" class="flex shrink-0 items-center" aria-label="Mundo Flavinha — página inicial">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="Mundo Flavinha"
        class="h-14 w-auto md:h-16"
      />
    </a>

    <nav aria-label="Navegação principal" class="hidden items-center gap-0.5 xl:flex">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            aria-current={ativo(item.path) ? "page" : undefined}
            class:list={[
              "rounded-full px-3.5 py-2 font-heading text-[0.95rem] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-uva",
              ativo(item.path) ? "bg-white/70 text-uva-ink" : "text-plum/75 hover:bg-white/60 hover:text-plum",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2 md:gap-3">
      <BuscaHeader />

      <a
        href="/brincadeiras"
        class="hidden rounded-full bg-rosa px-6 py-3 font-heading text-[0.95rem] font-bold text-plum shadow-[0_10px_24px_-14px_hsl(var(--rosa))] transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-plum focus-visible:ring-offset-2 md:inline-flex"
      >
        Começar a brincar
      </a>

      <button
        type="button"
        id="botao-menu"
        class="rounded-full p-2.5 text-plum transition-colors hover:bg-white/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-uva xl:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <Icon name="lucide:menu" class="h-6 w-6" data-icone="abrir" />
        <Icon name="lucide:x" class="hidden h-6 w-6" data-icone="fechar" />
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="hidden border-t border-plum/10 bg-creme/95 backdrop-blur-md xl:hidden">
    <nav aria-label="Navegação principal" class="container flex flex-col gap-1 py-4">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            aria-current={ativo(item.path) ? "page" : undefined}
            class:list={[
              "rounded-2xl px-4 py-3 font-heading font-semibold transition-colors",
              ativo(item.path) ? "bg-white text-uva-ink" : "text-plum/80 hover:bg-white/70",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/brincadeiras"
        class="mt-2 inline-flex w-full items-center justify-center rounded-full bg-rosa px-4 py-3 font-heading font-bold text-plum md:hidden"
      >
        Começar a brincar
      </a>
    </nav>
  </div>
</header>

<script>
  const botao = document.getElementById("botao-menu");
  const menu = document.getElementById("menu-mobile");

  if (botao && menu) {
    const iconeAbrir = botao.querySelector<SVGElement>('[data-icone="abrir"]');
    const iconeFechar = botao.querySelector<SVGElement>('[data-icone="fechar"]');

    botao.addEventListener("click", () => {
      const aberto = botao.getAttribute("aria-expanded") === "true";
      const proximo = !aberto;

      botao.setAttribute("aria-expanded", String(proximo));
      botao.setAttribute("aria-label", proximo ? "Fechar menu" : "Abrir menu");
      menu.classList.toggle("hidden", !proximo);
      iconeAbrir?.classList.toggle("hidden", proximo);
      iconeFechar?.classList.toggle("hidden", !proximo);
    });
  }

  /*
   * Só na home o header nasce transparente, então só nela existe estado de
   * "rolado". O listener é passivo e escreve um atributo — quem pinta é o CSS,
   * o que mantém o scroll fora da thread de layout do JS.
   */
  const cabecalho = document.querySelector<HTMLElement>("[data-cabecalho][data-sobreposto]");

  if (cabecalho) {
    const sincronizar = () => {
      cabecalho.dataset.rolado = String(window.scrollY > 12);
    };

    sincronizar();
    window.addEventListener("scroll", sincronizar, { passive: true });
  }
</script>
