---
import YouTubeFacade from "./YouTubeFacade.astro";

/**
 * Facade do YouTube que se atualiza para o vídeo MAIS RECENTE do canal.
 *
 * O `videoId`/`title`/`start` abaixo não são o vídeo dinâmico — são o
 * FALLBACK: o que aparece sem JavaScript, para crawler, e enquanto (ou se) a
 * busca do último vídeo falha ou ainda não respondeu. É um vídeo real, com o
 * título real dele (conferido via oEmbed público), não um placeholder — o
 * `<script>` abaixo só troca por algo melhor, nunca por um estado vazio.
 *
 * Por que não virou ilha React: o resto desta página não hidrata nada além do
 * botão de captura de lead (`LeadModal`), e replicar aqui o mesmo fetch +
 * validação que `getChannelVideos` já faz — só que via `<script>` puro, como
 * o próprio `YouTubeFacade.astro` já faz para o clique — evita adicionar um
 * segundo caminho de consentimento (ver comentário em consentimentoMidia.ts:
 * o design é para EXATAMENTE dois lugares montarem um player, o facade
 * estático e o diálogo da galeria).
 *
 * A atualização troca dataset.src/title/linkDireto e a miniatura do MESMO
 * <button> que já está na página, sem recriar o elemento — o listener de
 * clique que YouTubeFacade.astro já anexou continua valendo, agora apontando
 * pro vídeo novo. Por isso não há necessidade de re-executar nenhuma lógica
 * de consentimento aqui.
 */

const FALLBACK = {
  videoId: "uuaYyN7v8H4",
  title: "Como fazer um baú do tesouro com caixa de papelão | Passo a passo fácil",
  start: 19,
};

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="ultimo-video-canal">
  <div class:list={["relative overflow-hidden rounded-2xl bg-foreground/5 shadow-lg aspect-video", className]}>
    <YouTubeFacade
      videoId={FALLBACK.videoId}
      title={FALLBACK.title}
      start={FALLBACK.start}
      class="h-full w-full"
    />
  </div>
  <p data-titulo-destaque class="mt-4 text-center font-heading text-lg font-bold leading-snug text-foreground">
    {FALLBACK.title}
  </p>
</div>

<script>
  import { getChannelVideos } from "@/lib/youtube";

  const raiz = document.getElementById("ultimo-video-canal");
  const botao = raiz?.querySelector<HTMLButtonElement>("[data-youtube-facade]");
  if (raiz && botao) {
    const miniatura = botao.querySelector<HTMLImageElement>("[data-thumb-facade]");
    const tituloDestaque = raiz.querySelector<HTMLElement>("[data-titulo-destaque]");
    const linkDireto = raiz.querySelector<HTMLAnchorElement>("[data-link-direto-facade]");

    getChannelVideos()
      .then(({ videos }) => {
        // `videos` já vem ordenado do mais novo pro mais antigo
        // (fetchChannelVideos ordena por publishedAt desc).
        const ultimo = videos[0];
        if (!ultimo) return;

        const src = `https://www.youtube-nocookie.com/embed/${ultimo.id}?autoplay=1&rel=0`;
        const urlDireta = `https://www.youtube.com/watch?v=${ultimo.id}`;

        botao.dataset.src = src;
        botao.dataset.title = ultimo.title;
        botao.dataset.linkDireto = urlDireta;
        botao.setAttribute("aria-label", `Assistir: ${ultimo.title}`);
        // Miniatura pelo proxy do próprio domínio — ver a nota em
        // YouTubeFacade.astro sobre por que não é i.ytimg.com direto. Se essa
        // troca falhar, o handler onerror já embutido no <img> remove a tag.
        if (miniatura) miniatura.src = `/api/thumb?id=${encodeURIComponent(ultimo.id)}`;
        if (tituloDestaque) tituloDestaque.textContent = ultimo.title;
        if (linkDireto) linkDireto.href = urlDireta;
      })
      // Sem tratamento visível de erro de propósito: o fallback (vídeo
      // estático, já publicado) continua na tela. Um card de erro aqui
      // trocaria "vídeo bom, um pouco antigo" por "seção quebrada" — a
      // troca errada para uma vitrine que a maioria das visitas nem clica.
      .catch((causa) => console.error("não foi possível atualizar o último vídeo do canal", causa));
  }
</script>
